import java.util.Scanner;

public class TrabalhoFinalArqueologiaMaba {

    // Dados da partida
    static int energia = 20;
    static int artefatos = 0;
    static int exploracoes = 0;

    // Dados gerais
    static int vitorias = 0;
    static int derrotas = 0;
    static int totalArtefatos = 0;

    private static boolean verificarFim() {
        if (energia <= 0 || artefatos >= 4 || exploracoes >= 12) {
            return true;
        } else {
            return false;
        }

    }

    private static void mostrarResultado() {
        if (energia <= 0) {
            System.out.println("Você perdeu! Sua energia acabou.");
            derrotas++;
        } else if (artefatos >= 4) {
            System.out.println("Parabéns! Você encontrou todos os artefatos!");
            vitorias++;
        } else if (exploracoes >= 12) {
            System.out.println("Você perdeu! Você não encontrou todos os artefatos.");
            derrotas++;
        }
    }

    private static void mostrarEstatisticas() {
        System.out.println("Estatísticas do jogo:");
        System.out.println("Vitórias: " + vitorias);
        System.out.println("Derrotas: " + derrotas);
        System.out.println("Total de artefatos encontrados: " + totalArtefatos);
    }

    private static void alterarEnergia(int quantidade) {
        energia += quantidade;
        if (energia > 30) {
            energia = 30;
        } else if (energia < 0) {
            energia = 0;
        }
    }

    private static void explorarPosicao(int[] mapa, int posicao) {
        if (posicaoJaExplorada(mapa, posicao)) {
            System.out.println("Posição já explorada!");
            return;
        }

        switch (mapa[posicao]) {

            case 1:
                System.out.println("Você encontrou uma fonte de energia! Ganhou 5 de energia.");
                alterarEnergia(5);
                break;
            case 2:
                System.out.println("Você encontrou um artefato!");
                artefatos++;
                totalArtefatos++;
                break;
            case 3:
                System.out.println("Você encontrou uma área de risco! Perdeu 4 de energia.");
                alterarEnergia(-4);
                break;
            default:
                System.out.println("Nada encontrado nesta posição.");
                alterarEnergia(-1);
                break;
        }
        mapa[posicao] = -1;
        exploracoes++;
    }

    private static void inicializarPartida() {
        energia = 20;
        artefatos = 0;
        exploracoes = 0;
    }

    private static boolean posicaoJaExplorada(int[] mapa, int posicao) {
        if (mapa[posicao] == -1) {
            return true;
        } else {
            return false;
        }
    }

    private static void colocarElementos(int[] mapa, int valor, int quantidade) {
        int colocados = 0;
        while (colocados < quantidade) {
            int posicao = (int) (Math.random() * mapa.length);
            if (mapa[posicao] == 0) {
                mapa[posicao] = valor;
                colocados++;
            }
        }
    }

    private static void gerarMapa(int[] mapa) {
        colocarElementos(mapa, 1, 6);
        colocarElementos(mapa, 2, 4);
        colocarElementos(mapa, 3, 8);

    }

    private static void mostrarMapa(int[] mapa) {
        System.out.println("Mapa da expedição:");
        for (int i = 0; i < mapa.length; i++) {
            System.out.print(mapa[i] + " ");
        }
        System.out.println();
    }

    public static void main(String[] args) {
        Scanner tec = new Scanner(System.in);
        int opcao = 0;

        while (opcao != 2) {
            System.out.println("1 - Iniciar expedição");
            System.out.println("2 - Encerrar jogo");
            opcao = tec.nextInt();

            switch (opcao) {
                case 1:
                    System.out.println("Expedição iniciada!");
                    int[] mapa = new int[30];
                    gerarMapa(mapa);
                    mostrarMapa(mapa);
                    inicializarPartida();
                    while (!verificarFim()) {

                        System.out.println("Escolha uma posição para explorar (0 a 29):");
                        int posicao = tec.nextInt();
                        if (posicao < 0 || posicao >= mapa.length) {
                            System.out.println("Posição inválida! Tente novamente.");
                            continue;
                        }
                        explorarPosicao(mapa, posicao);
                        mostrarMapa(mapa);
                    }
                    System.out.println("Fim da expedição!");
                    mostrarResultado();
                    System.out.println("Energia: " + energia);
                    System.out.println("Artefatos: " + artefatos);
                    System.out.println("Explorações: " + exploracoes);
                    break;
                case 2:
                    System.out.println("Jogo encerrado!");
                    mostrarEstatisticas();
                    break;
            }
        }
    }
}
